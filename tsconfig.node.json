{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [
      "node",
      "vite/client",
      "vitest/globals"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.test.ts",
    "src/test",
    "src/env.d.ts",
    "vite.config.ts"
  ]
}
